# Which LLM to use: gemini | openai | deepseek (default: gemini)
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Optional; default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI / ChatGPT (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Optional; default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek (LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=
# Optional; default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Optional fallbacks used by any provider if the specific vars above are empty
# LLM_API_KEY=
# LLM_MODEL=

# Required for internet search; if omitted, regular LLM answers still work
SERPER_API_KEY=
